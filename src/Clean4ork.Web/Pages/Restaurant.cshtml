@page "/r/{jurisdiction}/{slug}"
@using Clean4ork.Core.Domain
@model RestaurantModel
@{
    var est = Model.Establishment!;
    ViewData["Title"] = $"{est.Name} \u2014 Clean4ork";
}

<div class="wrap">
  <a class="back" href="/">&larr; Back to search</a>

  <section class="hero">
    @if (!string.IsNullOrEmpty(Model.GradeLetter))
    {
      <div class="placard g@(Model.GradeLetter.ToLowerInvariant())"><span class="pl-letter">@Model.GradeLetter</span><span class="pl-cap">Grade</span></div>
    }
    else if (est.DataTier == DataTier.PassFail && est.SnapshotPassed is bool passed)
    {
      <div class="chit @(passed ? "pass" : "fail")"><span class="chit-res">@(passed ? "Passed" : "Out of compliance")</span><span class="chit-cap">State record</span></div>
    }
    else
    {
      <div class="chit"><span class="chit-cap">No record</span></div>
    }

    <div class="info">
      <h1>@est.Name</h1>
      @if (Model.AddressLine is not null) { <div class="meta">@Model.AddressLine</div> }
      <span class="tier">
        @(est.DataTier == DataTier.Scored ? "Graded from city inspection reports"
          : est.DataTier == DataTier.PassFail ? "State pass/fail record"
          : "No inspection data")
      </span>
    </div>
  </section>

  @if (!string.IsNullOrEmpty(Model.GradeLetter))
  {
    <p class="note" style="margin-top:12px">Clean4ork grade as of @Model.GradeAsOf.</p>

    <section class="section">
      <h2>Violations on record</h2>
      @if (Model.Factors.Count == 0)
      {
        <p class="note">No violations on recent inspections.</p>
      }
      else
      {
        <table class="factors">
          <thead><tr><th>Violation</th><th>Inspected</th><th></th></tr></thead>
          <tbody>
            @foreach (var f in Model.Factors)
            {
              <tr>
                <td>@f.Description <span class="code mono">(@f.Code)</span></td>
                <td class="mono">@f.Inspected</td>
                <td>@if (f.IsRepeat) { <span class="badge-repeat">Repeat</span> }</td>
              </tr>
            }
          </tbody>
        </table>
      }
    </section>
  }
  else if (Model.Snapshot is { } snap)
  {
    <section class="section">
      <div class="pf-card freshness-@snap.Freshness.ToString().ToLowerInvariant()">
        <p class="h">@snap.Headline</p>
        <p class="note" style="margin:0">@snap.SubText</p>
      </div>
      <p class="note" style="margin-top:12px">
        This area isn't graded yet. When detailed inspection reports are available here,
        we'll show a full Clean4ork grade.
      </p>
    </section>
  }
  else
  {
    <section class="section"><div class="empty">We don't have an inspection on record for this location yet.</div></section>
  }

  <p class="note" style="margin-top:26px;font-size:13px">
    See the official health department record for the authoritative report.
  </p>
</div>