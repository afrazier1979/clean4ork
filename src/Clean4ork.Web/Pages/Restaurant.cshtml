@page "/r/{jurisdiction}/{slug}"
@using Clean4ork.Core.Domain
@model RestaurantModel
@{
    var est = Model.Establishment!;
    ViewData["Title"] = $"{est.Name} \u2014 Clean4ork";
    var graded = !string.IsNullOrEmpty(Model.GradeLetter);
    var g = Model.GradeLetter ?? "";
    var phrase = g switch
    {
        "A" => "Consistently clean",
        "B" => "Minor issues",
        "C" => "Some concerns",
        "D" => "Repeated concerns",
        "F" => "Serious problems",
        _ => ""
    };
}

<main class="wrap detail">
  <a class="back" href="/">&larr; Back to search</a>

  <article class="panel">
    <div class="dhead">
      <div class="tierflag">
        @(graded ? "Graded area" : est.DataTier == DataTier.PassFail ? "Pass / fail area" : "No inspection data")
      </div>
      <h1>@est.Name</h1>
      @if (Model.AddressLine is not null) { <div class="addr">@Model.AddressLine</div> }
    </div>

    <div class="dbody">
      @if (graded)
      {
        <div class="hero-scored">
          <div class="placard g-@(g.ToLowerInvariant())"><div class="g">@g</div><div class="s">Grade</div></div>
          <div class="about">
            <h4>@phrase</h4>
            <p>The Clean4ork grade is our reading of the city's inspection record. Every violation behind it is listed below.</p>
            <div class="asof">As of @Model.GradeAsOf</div>
          </div>
        </div>

        <div class="section-title">Violations on record</div>
        @if (Model.Factors.Count == 0)
        {
          <p class="quiet">No violations on recent inspections.</p>
        }
        else
        {
          <table class="factors">
            <tbody>
              @foreach (var f in Model.Factors)
              {
                <tr>
                  <td>@f.Description<div class="code">FDA item @f.Code</div></td>
                  <td class="when">@f.Inspected@if (f.IsRepeat) { <span class="repeat">Repeat</span> }</td>
                </tr>
              }
            </tbody>
          </table>
        }
      }
      else if (Model.Snapshot is { } snap)
      {
        var cls = est.SnapshotPassed switch { true => "pass", false => "fail", _ => "unknown" };
        var stamp = est.SnapshotPassed switch { true => "Passed", false => "Out of compliance", _ => "No result on file" };
        var fresh = snap.Freshness.ToString().ToLowerInvariant();

        <div class="hero-pf @cls">
          <span class="stamp-lg">@stamp</span>
          <div class="headline">
            @snap.Headline
            @if (fresh == "stale") { <span class="freshtag stale">Months old</span> }
            else if (fresh == "expired") { <span class="freshtag expired">Archived</span> }
          </div>
          <p class="sub">@snap.SubText</p>
        </div>
        <div class="notegrade">
          This area isn't graded yet. We show the inspection result, not a Clean4ork grade.
          When detailed reports become available here, this page graduates to a full grade.
        </div>
      }
      else
      {
        <div class="empty">We don't have an inspection on record for this location yet.</div>
      }

      <p class="disclaimer">
        Clean4ork is a private company that reads public records. This is our analysis of published
        inspection data, not an official health department grade. See the official record for the
        authoritative report.
      </p>
    </div>
  </article>
</main>