@page
@model IndexModel
@{
    ViewData["Title"] = "Clean4ork \u2014 Pennsylvania food inspections";
}

<div class="wrap">
  <form class="search" method="get" action="/">
    <input type="text" name="Q" value="@Model.Q" placeholder="Search a restaurant by name" />
    @if (!string.IsNullOrWhiteSpace(Model.Area))
    {
      <input type="hidden" name="area" value="@Model.Area" />
    }
    <button class="btn" type="submit">Search</button>
  </form>

  <div class="chips">
    <a class="@(string.IsNullOrWhiteSpace(Model.Area) ? "on" : "")" href="@Model.Link(1, "")">All of PA</a>
    <a class="@(Model.Area == "philly" ? "on" : "")" href="@Model.Link(1, "philly")">Philadelphia</a>
    <a class="@(Model.Area == "pa" ? "on" : "")" href="@Model.Link(1, "pa")">Rest of PA</a>
  </div>

  <div class="count">
    @if (Model.TotalCount > 0) { <text>Showing @Model.FirstShown.ToString("N0")&ndash;@Model.LastShown.ToString("N0") of </text> }
    @Model.TotalCount.ToString("N0") result@(Model.TotalCount == 1 ? "" : "s")
  </div>

  @if (Model.Results.Count == 0)
  {
    <div class="empty">No restaurants match that search.</div>
  }
  else
  {
    @foreach (var r in Model.Results)
    {
      <a class="card" href="/r/@r.Jurisdiction/@r.Slug">
        @if (r.Tier == DataTier.Scored && r.Grade is char g)
        {
          <div class="placard g@(char.ToLowerInvariant(g))"><span class="pl-letter">@g</span><span class="pl-cap">Grade</span></div>
        }
        else if (r.Passed is bool passed)
        {
          <div class="chit @(passed ? "pass" : "fail")"><span class="chit-res">@(passed ? "Passed" : "Out of compliance")</span><span class="chit-cap">State record</span></div>
        }
        else
        {
          <div class="chit"><span class="chit-cap">No record</span></div>
        }
        <div class="info">
          <div class="name">@r.Name</div>
          <div class="meta">
            @r.Address
            @if (r.Place is not null) { <text> &middot; @r.Place</text> }
          </div>
          <div class="meta mono">
            @if (r.Tier == DataTier.Scored) { <text>Graded from city inspection reports</text> }
            else if (r.InspectedOn is not null) { <text>State inspection @r.InspectedOn</text> }
            else { <text>No inspection on record</text> }
          </div>
        </div>
      </a>
    }
  }

  @if (Model.TotalPages > 1)
  {
    <nav class="pager">
      @if (Model.PageNumber > 1) { <a href="@Model.Link(Model.PageNumber - 1)">&larr; Previous</a> } else { <span class="off">&larr; Previous</span> }
      <span class="where">Page @Model.PageNumber.ToString("N0") of @Model.TotalPages.ToString("N0")</span>
      @if (Model.PageNumber < Model.TotalPages) { <a href="@Model.Link(Model.PageNumber + 1)">Next &rarr;</a> } else { <span class="off">Next &rarr;</span> }
    </nav>
  }
</div>